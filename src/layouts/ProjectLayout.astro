---
import RootLayout from "./RootLayout.astro";
import Footer from "@components/footer.astro";
import LineAnimation from "@components/height-animation.astro";

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
---
<!--If you want to constraint the expasion of the max-w-screen-xl  -->
<RootLayout title={title} description={description}>
	<div class="flex relative w gap-4 w-full">
		<nav class="relative w-4 md:min-w-2xs xl:min-w-sm sm:min-h-screen sm:ml-4 sm:pb-4 ">
			<div class="w-full h-full  not-sm:bg-amber-500 max-sm:w-4 md:max-w-2xs xl:max-w-sm fixed -z-10 sm:bottom-4 rounded-b-2xl overflow-hidden">
				<div class="absolute w-full h-full sm:min-h-screen -z-10">
				<LineAnimation />
				</div>
			</div>
		</nav>

		<!--
		Multicolor: 
				color1="#4A8A4C"
				color2="#D88FCE"
				color3="#D58348"
		-->


		<main class="relative flex-1 "  >
			<slot />
			<Footer />
		</main>


	</div>
</RootLayout>