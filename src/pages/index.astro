---
import H1 from "@components/h1.astro";
import H2 from "@components/h2.astro";
import Link from "@components/link.astro";
import Navigation from "@components/navigation";
import RootLayout from "@layouts/RootLayout.astro";
import WarpBackground from "@components/warp-background";
import LineAnimation from "@components/width-animation.astro";
import AvailableForWork from "@components/available.astro";
---

<RootLayout>
	<main>
		<div
			class="group relative w-full min-h-screen flex items-center justify-center"
		>
			<div class="absolute w-full h-full sm:min-h-screen -z-10">
				<LineAnimation/>
				{
					/* //Black
					color1="#09090b"
					color2="#27272a"
					color3="#52525b"

					//Blue
					color1="#133463"
					color2="#365FB7"
					color3="#799AE0"

					color1="#4F6BBF"  
  	color2="#799AE0"  
  color3="#B3C9F4"
				 */
				}
			</div>

			<div
				class="p-4 sm:p-8 absolute w-full flex flex-col justify-between min-h-screen z-10"
			>
				<div >
					<H1 size="large" className="mt-60">
						 DANIEL D.D.
					</H1>
				</div>

				<div>
					<AvailableForWork className="py-4" />
					<div class="mb-2 sm:mb-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<Link href="tel:+610426540773">F.O.M.O Call !</Link>
							<Link href="/projects" variant="secondary"
								>View trajectory</Link
							>
						</div>

						<Navigation client:load>
							<Link href="/blog" variant="secondary">Blog</Link>
							<Link href="/about" variant="secondary">About</Link>
							<Link href="/contact" variant="secondary"
								>Contact</Link
							>
						</Navigation>
					</div>
				</div>
			</div>
		</div>
	</main>
</RootLayout>
