---
import { Image } from "astro:assets";
import H2 from "@components/h2.astro";
import InfoLayout from "@layouts/InfoLayout.astro";
import gyellow from "@assets/gyellow.jpg";

import code from "@assets/code-asset-6.jpg";
import drone from "@assets/bondi.jpg";

const dronePage = "/projects/drone";
const developerPage="/projects/developer";

const projects = [
     {
          title: "Drone Pilot",
          description:
               "Drone flying for advertisement and fun",
          image: drone,
          hoverImage: gyellow,
          page: dronePage,
     },
     {
          title: "Developer",
          description:
               "Data Analisys & Softare Game Developer.",
          image: code,
          hoverImage: gyellow,
          page: developerPage,
     }
];
---

<InfoLayout>
     <div class="w-full p-4 sm:pt-8 sm:px-12 pb-20 min-h-screen">
         

          <ul
               class="w-full sm:mt-12 grid grid-cols-1 sm:grid-cols-2 gap-12 sm:gap-8  max-h-screen"
          >
               {
                    projects.map((project) => (
                         <li>
                              <div class="relative w-full aspect-[1/1.1] max-h-120 overflow-hidden rounded-lg shadow-lg mb-4 xl:mb-4 sm:mb-0 sm:mr-4 group hover:scale-105">
                                  <a href={project.page}><Image
                                        src={project.image}
                                        alt={project.title}
                                        
                                        class="w-full aspect-[1/1.1] object-center object-cover rounded-lg shadow-lg mb-4 xl:mb-4 sm:mb-0 sm:mr-4 transition hover:scale-105 opacity-80 duration-300"
                                   />
                                   <Image
                                        src={project.hoverImage}
                                        alt={project.title}
                                        class="absolute inset-0 w-full h-full object-cover object-center opacity-0 blur-none group-hover:opacity-40 group-hover:blur-sm group-hover:scale-105 transition duration-300"
                                   >
                                   </Image></a>
                              </div>
                              <div class="p-1 sm:p-2">
                                   <H2 size="default">{project.title}</H2>
                                   <p class="text-sm sm:text-base md:text-md text-zinc-400 text-balance max-w-prose mx-auto justify-start">
                                        {project.description}
                                   </p>
                              </div>
                         </li>
                    ))
               }
          </ul>
     </div>
</InfoLayout>
