---
import clsx from "clsx/lite";

type Props = {
    className?: string;
    size?: "default" | "large";
}

const { size = "default", className } = Astro.props;
---
{/*tracking: cambia el espaciado de letras */}
<h1
    class={clsx(
        "text-gray-100 font-bold text-balance",
        size === "default" && "text-4xl md:text-6xl xl:text-8xl tracking-tight",
        size === "large" && "text-7xl md:text-[80]/24 lg:text-[92px]/26 tracking-tight",
        className,
    )}
>
    <slot />
</h1>
