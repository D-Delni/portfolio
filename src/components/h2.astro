---
// h2.astro
import clsx from "clsx/lite";

type Props = {
    className?: string;
    size?: "default" | "large";
}

const { size = "default", className } = Astro.props;
---

<!--font-geist -->

<h2
    class={clsx(
        "text-gray-200 font-semibold text-balance ",
        size === "default" && "text-3xl md:text-3xl xl:text-5xl tracking-tight",
        size === "large" && "text-5x1 md:text-5xl  lg:text-[60px]/16 tracking-tighter",
        className,
    )}
>
    <slot />
</h2>
